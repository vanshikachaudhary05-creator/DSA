#include <bits/stdc++.h>

using namespace std;
const int N=5;
int arr[N];
int top=-1;
void push(){
    int x;
    cout<<"enter data";
    cin>>x;
    if(top==N-1){
        cout<<"overflow";
    }
    else{
        top++;
        arr[top]=x;
    }
}
void pop(){
    int item;
    if(top==-1){
        cout<<"underflow";
    }
    else{
      int  item=arr[top];
        top--;
        cout<<item;
    }
}
void peek(){
    if(top==-1){
        cout<<"stack is underflow";
        return;
    }
    else{
        cout<<"the top most element is"<<arr[top]<<endl;
    }
}
void display(){
    if(top==-1){
        cout<<"stack is empty";
        return;
    }
    cout<<"stacks element are:";
    for(int i=top;i>=0;i--){
        cout<<arr[i]<<" ";
    }
    cout<<endl;
}
int main() {
	// your code goes here
int ch;

do{
    cout<<"\n1:Push\n 2:Pop\n  3:Peek\n 4:display\n";
    cout<<"enter choice:";
    cin>>ch;
    switch(ch)
    {
        case 1:push();
        break;
        case 2:pop();
        break;
        case 3:peek();
        break;
        case 4:display();
        break;
        case 0:cout<<"exiting...\n"; break;
        default:
        cout<<"invalid choice\n";
        
    }
}
    while(ch!=0);
        
    

return 0;
}
