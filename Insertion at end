#include <bits/stdc++.h>
using namespace std;
class Node{
    public:int data;
    Node*next;
    Node(int x){
        data=x;
        next=nullptr;
    }
};

Node*insertAfterPos(Node*head,int pos,int x){
    Node*newNode=new Node(x);
    if(head==nullptr){
        return newNode;
    }
    Node*temp=head;
    for(int i=1;i<pos&&temp!=nullptr;i++)
    {
        temp=temp->next;
    }
    if(temp==nullptr){
        cout<<"invalid pos"<<endl;
        delete newNode;
        return head;
    }
    newNode->next=temp->next;
    temp->next=newNode;
