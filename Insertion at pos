#include <bits/stdc++.h>
using namespace std;
class Node{
    public:int data;
    Node*next;
    Node(int x){
        data=x;
        next=nullptr;
    }
};

Node*insertAfterPos(Node*head,int pos,int x){
    Node*newNode=new Node(x);
    if(head==nullptr){
        return newNode;
    }
    Node*temp=head;
    for(int i=1;i<pos&&temp!=nullptr;i++)
    {
        temp=temp->next;
    }
    if(temp==nullptr){
        cout<<"invalid pos"<<endl;
        delete newNode;
        return head;
    }
    newNode->next=temp->next;
    temp->next=new Node;
return head;
}

// Function to print the linked list
void printList(Node* head) {
    Node* curr = head;

    while (curr != nullptr) {
        cout << curr->data;
        if (curr->next != nullptr) {
            cout << " -> ";
        }
        curr = curr->next;
    }
    cout << endl;
}

int main() {
    Node* head = new Node(9);
    head->next = new Node(8);
    head->next->next = new Node(7);
    head->next->next->next = new Node(6);

    int pos = 2;   // Insert after the 2nd node
    int x = 10;

    head = insertAfterPosition(head, pos, x);

    printList(head);

    return 0;
}

