#include <bits/stdc++.h>
using namespace std;
class Node{
    public:int data;
    Node*prev;
    Node*next;
    Node(int x){
        data=x;
        next=nullptr;
        prev=nullptr;
    }
};
Node*create(Node*&tail){
    Node*head=nullptr;
    
   
        int data;
        while(cin>>data&&data!=-1){
        
        Node*newNode=new Node(data);
        if(head==nullptr){
            head=tail=newNode;
            head->next=head;
            head->prev=head;
        }
        else{
            tail->next=newNode;
            newNode->prev=tail;
            newNode->next=head;
            head->prev=newNode;
            tail=newNode;
            
        }
        
        
        
    }
    return head;
}
void display(Node*head){
    if(head==nullptr){
        cout<<"list is empty"<<endl;
        return;
    }
        
            Node*temp=head;
            do{
                cout<<temp->data<<" ";
                temp=temp->next;
            }
            while(temp!=head);
        cout<<endl;
    }

