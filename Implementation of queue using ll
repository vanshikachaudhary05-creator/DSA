#include <bits/stdc++.h>
using namespace std;
class Node{
  public:  int data;
    Node*next;
    Node(int x)
    {
    data=x;
    next=nullptr;
}
};
Node*front=nullptr;
Node*rear=nullptr;
void enqueue(int x){
    
    Node*newNode=new Node(x);
    newNode->data=x;
    newNode->next=nullptr;
    if(front==nullptr&&rear==nullptr){
        front=rear=newNode;
    }
    else{
        rear->next=newNode;
        rear=newNode;
    }
}
void display(){
    if(front==nullptr&&rear==nullptr){
        cout<<"empty"<<endl;
    }
    else{
        Node*temp=front;
        while(temp!=nullptr){
            
            cout<<temp->data<<" "<<endl;
            temp=temp->next;
        }
    }
}
void dequeue(){
    if(front==nullptr&&rear==nullptr){
        cout<<"empty"<<endl;
    }
    else{
        Node*temp=front;
        cout<<front->data<<endl;
        front=front->next;
        delete temp;
    }
}
void peek(){
    if(front==nullptr&&rear==nullptr){
        cout<<"empty"<<endl;
    }
    else{
        cout<<front->data<<" "<<endl;
    }
}
int main() {
	// your code goes here
enqueue(5);
enqueue(0);
enqueue(-3);

display();
dequeue();
peek();
return 0;
}
