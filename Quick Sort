#include <bits/stdc++.h>
using namespace std;
int Partition(int A[], int lb,int ub){
   int pivot=A[lb];
    int start=lb;
   int end=ub;
    while(start<end){
        while(start<=ub && A[start]<=pivot){
            start++;
        }
        while(A[end]>pivot){
            end--;
        }
        if(start<end){
            swap(A[start],A[end]);
        }
    }
    swap(A[lb],A[end]);
    return end;
}
int main() {
	// your code goes here
int A[]={7,8,9,11,2,3,4,9,8};
int n=sizeof(A)/sizeof(A[0]);
int pos=Partition(A,0,n-1);
cout<<pos<<endl;
for( int i=0;i<n;i++){
    cout<<A[i]<<" ";
    
}
return 0;
