#include <bits/stdc++.h>
using namespace std;
class Node{
   public: int data;
    Node*left,*right;
    Node(int x){
        data=x;
        left=nullptr;
        right=nullptr;
    }
};
Node*create(){
    int x;
    cin>>x;
    Node*newNode=new Node(x);
    if(x==-1){
        return nullptr;
    }
    cout<<"left child"<<x<<endl;
    newNode->left=create();
    cout<<"right child"<<x<<endl;
    newNode->right=create();
    return newNode;
    
}
void preorder(Node*root){
    if(root==nullptr){
        return ;
    }
    cout<<root->data<<endl;
    preorder(root->left);
    preorder(root->right);
    
}
void inorder(Node*root){
    if(root==nullptr){
        return ;
    }
    inorder(root->left);
    cout<<root->data<<endl;
    inorder(root->right);
}
void postorder(Node*root){
    if(root==nullptr){
        return ;
    }
    postorder(root->left);
    postorder(root->right);
    cout<<root->data<<endl;
}
int main() {
	// your code goes here
Node*root=create();
cout<<"preorder is:"<<endl;
preorder(root);
cout<<"inorder is:"<<endl;
inorder(root);
cout<<"postorder is:"<<endl;
postorder(root);
return 0;
}
