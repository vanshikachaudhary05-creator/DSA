#include <bits/stdc++.h>
using namespace std;
class Node{
    public:int data;
    Node*left,*right;
    Node(int x){
        data=x;
        left=nullptr;
        right=nullptr;
    }
};
Node*create(){
    int x;
    cin>>x;
    Node*newNode=new Node(x);
    if(x==-1){
       return nullptr;
    }
   
    cout<<"left child"<<x<<endl;
    newNode ->left=create();
    cout<<"right child"<<x<<endl;
    newNode ->right=create();
    return newNode;
}
