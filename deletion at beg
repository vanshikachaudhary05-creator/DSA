#include <bits/stdc++.h>
using namespace std;
class Node{
    public:int data;
    Node*next;
    Node(int x){
        data=x;
        next=nullptr;
    }
};
Node*deleteAtBeg(Node*head){
    if(head==nullptr){
        return nullptr;
    }
    else{
        Node*temp;
        temp=head;
        head=head->next;
        delete temp;
    }
    return head;
}
void displayList(Node*head){
    Node*temp=head;
    while(temp!=nullptr){
        cout<<temp->data<<" ";
        temp=temp->next;
    }
    cout<<endl;
}

int main() {
	// your code goes here
Node*head=new Node(9);
head->next=new Node(4);
head->next->next=new Node(5);
cout<<"before deletion: ";
displayList(head);
head=deleteAtBeg(head);
cout<<"after deletion: ";
displayList(head);
return 0;
}
