#include <bits/stdc++.h>
using namespace std;
class Node{
    public:int data;
    Node*next;
    Node(int x){
        data=x;
        next=nullptr;
    }
};
Node*create(){
    Node*head=nullptr;
    Node*tail=nullptr;
    int choice=1;
    while(choice){
        int data;
        cin>>data;
        Node*newNode=new Node(data);
        newNode->next=nullptr;
        if(head==nullptr){
            head=tail=newNode;
            tail->next=head;
        }
        else{
            tail->next=newNode;
            tail=newNode;
            tail->next=head;
        }
        cout<<"enter choice(1/0):";
        cin>>choice;
    }
    return tail;
}
Node*delAtEnd(Node*tail){
    Node*curr,*prev=nullptr;
    curr=tail->next;
    if(tail==nullptr){
        cout<<"list is empty";
    }
    else if(curr->next==curr){
        tail = nullptr;
        delete curr;
    }
    else{
        while(curr->next!=tail->next){
            prev=curr;
            curr=curr->next;
        }
        prev->next=tail->next;
        tail = prev;
        delete curr;
    }
    return tail;
}
void display(Node*tail){
    if(tail==nullptr){
        cout<<"list is empty";
        return;
    }
    Node*temp=tail->next;
    do{
        cout<<temp->data<<" ";
        temp=temp->next;
    }
    while(temp!=tail->next);
    cout<<endl;
}
int main() {
	// your code goes here
Node*tail=create();
display(tail);
tail=delAtEnd(tail);
display(tail);
return 0;
}
