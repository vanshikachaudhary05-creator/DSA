//at any specific position 
#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int n,pos,num;

cin>>n>>pos>>num;
vector<int >arr(n);
for(int i=0;i<n;i++){
    cin>>arr[i];
}
for(int i=n-1;i>=pos-1;i--){
    arr[i+1]=arr[i];
}
    
    arr[pos-1]=num;
    n++;
for(int i=0;i<n;i++){
    cout<<arr[i]<<" ";
}
return 0;
}

