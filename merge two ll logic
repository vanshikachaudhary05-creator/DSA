SinglyLinkedListNode* mergeLists(SinglyLinkedListNode* head1, SinglyLinkedListNode* head2) {

    // If one list is empty
    if (head1 == nullptr)
        return head2;
    if (head2 == nullptr)
        return head1;

    SinglyLinkedListNode* head = nullptr;
    SinglyLinkedListNode* tail = nullptr;

    // Set the head of the merged list
    if (head1->data <= head2->data) {
        head = tail = head1;
        head1 = head1->next;
    } else {
        head = tail = head2;
        head2 = head2->next;
    }

    // Merge while both lists have nodes
    while (head1 != nullptr && head2 != nullptr) {
        if (head1->data <= head2->data) {
            tail->next = head1;
            tail = head1;
            head1 = head1->next;
        } else {
            tail->next = head2;
            tail = head2;
            head2 = head2->next;
        }
    }

    // Attach the remaining nodes
    if (head1 != nullptr)
        tail->next = head1;
    else
        tail->next = head2;

    return head;
}
