 Node*insertAtBeg(Node*head){
     
     int value;
     cin>>value;
     Node*newNode=new Node(value);
     newNode->next=nullptr;
     if(head==nullptr){
         head=newNode;
         head->next=newNode;
     }
     Node*temp=head;
     while(temp->next!=head){
         temp=temp->next;
     }
         newNode->next=temp->next;
         temp->next=newNode;
         head=newNode;
