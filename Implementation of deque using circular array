#include <bits/stdc++.h>
#define N 5

using namespace std;
int arr[N];
int front=-1,rear=-1;
void enqueueFront(int x){
    if((front==0&&rear==N-1)||(front==rear+1)){
        cout<<"full"<<endl;
    }
    else if(front==-1&&rear==-1){
        front=rear=0;
        arr[front]=x;
    }
    else if(front==0){
        front=N-1;
        arr[front]=x;
    }
    else{
        front--;
        arr[front]=x;
    }
}
void enqueueRear(int x){
    if((front==0&&rear==N-1)||(front==rear+1)){
        cout<<"full"<<endl;
    }
   else if(front==-1&&rear==-1){
        front=rear=0;
        arr[rear]=x;
    }
    else if(rear==N-1){
        rear=0;
        arr[rear]=x;
    }
    else {
        rear++;
        arr[rear]=x;
    }
}
void display(){
    if(front==-1&&rear==-1){
        cout<<"empty"<<endl;
        return;
    }
    int i=front;
    while(i!=rear){
        cout<<arr[i]<<" ";
        i=(i+1)%N;
    }
    cout<<arr[rear]<<endl;
}
