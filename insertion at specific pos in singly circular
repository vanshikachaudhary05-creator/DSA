 Node*insertAtPos(Node*head){
     
     int value,pos;
     cin>>value;
     cin>>pos;
     Node*newNode=new Node(value);
     
     if(head==nullptr){
         if(pos==1){
         head=newNode;
         head->next=head;
         return head;
     }
     else{
         cout<<"invalid pos";
         delete newNode;
         return head;
     }
     }
     if(pos==1){
         Node*last=head;
         while(last->next!=head){
             last=last->next;
         }
         newNode->next=head;
         last->next=newNode;
         head=newNode;
         return head;
     }
     Node*temp=head;
     for(int i=1;i<pos-1&&temp->next!=head;i++){
         temp=temp->next;
     }
     if(temp->next==head&&pos>2){
         int count=1;
         Node*p=head;
         while(p->next!=head){
             count++;
             p=p->next;
         }
         if(pos>count+1){
             cout<<"invalid pos";
             delete newNode;
             return head;
         }
     }
       
         newNode->next=temp->next;
         temp->next=newNode;
         return head;
     
 }
